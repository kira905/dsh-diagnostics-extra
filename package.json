{
  "name": "@kira905/dsh-diagnostics-extra",
  "version": "0.1.1",
  "description": "DeepSeek Harness (DSH) diagnostics & reconciliation utilities: image-attachment audit/fetch (TRANSPORT root cause), one-command health check (host / dsh & guard start times / port connections), and an owner-action scanner. Zero third-party runtime dependencies.",
  "license": "AGPL-3.0-only",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dsh-attachments-audit": "attachments-audit.mjs",
    "dsh-attachments-fetch": "attachments-fetch.mjs",
    "dsh-why": "dsh-why.mjs",
    "dsh-owner-todo-scan": "owner-todo-scan.mjs"
  },
  "files": [
    "*.mjs",
    "lib/",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "diagnostics",
    "attachments",
    "session",
    "reconciliation",
    "health-check",
    "todo-scan",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kira905/dsh-diagnostics-extra.git"
  },
  "homepage": "https://github.com/kira905/dsh-diagnostics-extra#readme",
  "bugs": {
    "url": "https://github.com/kira905/dsh-diagnostics-extra/issues"
  }
}
